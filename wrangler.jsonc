{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orion-pci-demo",
  "main": "server/cloudflare/worker.mjs",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/source/orion-source.tar.gz"],
  },
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "durable_objects": {
    "bindings": [{ "name": "ORION_DEMO", "class_name": "OrionDemo" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["OrionDemo"] }],
  "vars": {
    "APP_MODE": "hosted-preview",
    "DEMO_DATA_ACK": "synthetic-only",
  },
  "observability": { "enabled": false },
}

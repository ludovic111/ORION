{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "orion-conduite",
  "pages_build_output_dir": "../dist-pages",
  "compatibility_date": "2026-09-19",
  "services": [{ "binding": "ORION_API", "service": "orion-pci-demo" }],
  "vars": { "PUBLIC_ORIGIN": "https://orion-conduite.pages.dev" },
}

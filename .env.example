# Local demonstration: loopback only, synthetic data, embedded PostgreSQL.
APP_MODE=demo
HOST=127.0.0.1
PORT=4311
APP_ORIGIN=http://127.0.0.1:4311
# Production: NODE_ENV=production, APP_MODE=institution, HTTPS origin,
# DATABASE_URL=postgresql://orion_app:...@db.internal:5432/orion
# DATABASE_CA_FILE=/run/secrets/postgres-ca.pem
# APP_KEY=<64 hex characters, from a secure random generator>
# Never put sslmode or other SSL query parameters in DATABASE_URL.
